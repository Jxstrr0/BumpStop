{
  "name": "bumpstop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bump Stop: build a rally truck, find the speed where it breaks, then go racing. A Longlight Interactive game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/big-shoulders": "5.3.0",
    "@fontsource/overpass-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
